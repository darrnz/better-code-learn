{
  "compilerOptions": {
    "target": "ES6",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["vitest"],
    "outDir": "./dist",
    "rootDir": "./src",  
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false
  },
  "include": ["./src/**/*.ts"],       
  "exclude": [
    "node_modules"
  ]
}